doctype html
html
  head
    title= title

    // Simple styling (CSS)
    style.
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        background-color: #f5f5f5;
      }

      nav {
        background-color: #0f9d7a;
        padding: 15px;
        text-align: center;
      }

      nav a {
        color: white;
        margin: 0 10px;
        text-decoration: none;
        font-weight: bold;
      }

      .container {
        width: 70%;
        margin: 40px auto;
        background: white;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0px 0px 5px rgba(0,0,0,0.1);
      }

      h1 {
        text-align: center;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }

      th, td {
        padding: 12px;
        border-bottom: 1px solid #ddd;
        text-align: left;
      }

      th {
        background-color: #f0f0f0;
      }

      .btn {
        background-color: #0f9d7a;
        color: white;
        padding: 6px 12px;
        text-decoration: none;
        border-radius: 3px;
      }

  body
    nav
      a(href='/') Dorm Share
      |  | 
      a(href='/items') Browse
      |  | 
      a(href='/my-listings') My Listings
      |  | 
      a(href='/profile') Profile
      |  | 
      a(href='/logout') Logout

    block content