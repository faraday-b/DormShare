extends layout

block content
  .users-page
    h1.users-heading Users List

    .users-search
      form.search-form(action="/users", method="GET")
        input(type="text", name="search", placeholder="Search users...", value=search || "")
        button.search-btn(type="submit") Search

    .users-table-box
      table.users-table
        thead
          tr
            th Username
            th Points
            th Status
            th Action
        tbody
          each user in users
            tr
              td= user.username
              td #{user.points} points
              td
                if user.is_banned
                  span.status-badge.status-rejected Banned
                else
                  span.status-badge.status-available Active
              td
                a.profile-btn(href=`/user/${user.id}/profile`) View Profile
